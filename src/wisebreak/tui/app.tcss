/* WISEBREAK — dark terminal theme with cyan accents */

Screen {
    background: #0b0f14;
    color: #cfe8ef;
}

Header {
    background: #06202a;
    color: #38bdf8;
    text-style: bold;
}

Footer {
    background: #06202a;
    color: #5eead4;
}

TabbedContent {
    height: 1fr;
}

Tabs {
    background: #06151c;
}

Tab {
    color: #7dd3fc;
}

.panel {
    padding: 1 2;
    height: 1fr;
}

.panel-title {
    text-style: bold;
    color: #38bdf8;
    padding-bottom: 1;
}

.hint {
    color: #64748b;
    text-style: italic;
}

.ok {
    color: #4ade80;
}

.warn {
    color: #fbbf24;
}

.bad {
    color: #f87171;
}

.toolbar {
    height: auto;
    padding-bottom: 1;
}

Input {
    border: tall #164e63;
    background: #08141b;
}

Input:focus {
    border: tall #38bdf8;
}

Button {
    background: #0e7490;
    color: #e0f2fe;
    border: none;
    margin: 0 1 0 0;
}

Button:hover {
    background: #0891b2;
}

Button.-primary {
    background: #0284c7;
}

DataTable {
    height: 1fr;
    background: #08141b;
}

DataTable > .datatable--header {
    background: #0b2a36;
    color: #7dd3fc;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #0e7490;
    color: #ffffff;
}

RichLog {
    background: #060d12;
    border: round #164e63;
    height: 1fr;
}

Markdown {
    background: #08141b;
    padding: 0 1;
}

#detail {
    border: round #164e63;
    height: auto;
    max-height: 18;
    padding: 1;
    background: #060d12;
}

#status-grid {
    height: auto;
    grid-size: 2;
    grid-gutter: 1 2;
}
